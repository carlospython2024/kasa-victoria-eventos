{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kasa-victoria-eventos",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/i/*",
      "/pedido",
      "/pedido/*",
      "/gestion",
      "/gestion/*",
      "/crear",
      "/crear/*",
      "/vista",
      "/vista/*",
      "/privacidad",
      "/privacidad/*",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kasa-victoria",
      "database_id": "1cc5e155-4e6f-462b-8c1e-2d1284e411ff",
      // Preserve the existing local review database. Remote previews need a separate D1 ID.
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "kasa-victoria-bucket" }],
  "vars": {
    "PUBLIC_ORIGIN": "https://kasa-victoria-eventos.carlosmatallanabisa830.workers.dev",
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true },
}
