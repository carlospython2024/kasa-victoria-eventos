# Copy to .env.local for development. Use environment variables in production.
# Node.js 24 or later; one application instance with persistent disk.
DATA_DIR=var
# Production requires NODE_ENV=production and a public HTTPS origin.
# PUBLIC_ORIGIN=https://your-domain.example
# ADMIN_SETUP_TOKEN=generate-a-long-random-one-time-setup-code
# BUSINESS_EMAIL=your-business-email
# EMAIL_FROM=Brand <orders@your-verified-domain.example>
# RESEND_API_KEY=provider-key-server-only
# Configure only after confirming the receiving account and its holder.
# PAYMENT_INSTRUCTIONS=Nequi: confirmed-number. Holder: confirmed-name.

# Cloudflare public build origin (must match Wrangler PUBLIC_ORIGIN).
# VITE_PUBLIC_ORIGIN=https://your-domain.example
