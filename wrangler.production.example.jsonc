{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "your-invitation-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/i/*",
      "/pedido",
      "/pedido/*",
      "/gestion",
      "/gestion/*",
      "/crear",
      "/crear/*",
      "/vista",
      "/vista/*",
      "/privacidad",
      "/privacidad/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "your-app-database",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "your-app-media"
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://your-worker.example",
    "BUSINESS_WHATSAPP": "",
    "PAYMENT_INSTRUCTIONS": ""
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
